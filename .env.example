# Copiar este archivo como .env y completarlo. El archivo .env no se sube a git.
# Proveedor del modelo de lenguaje: gemini u ollama.
AIDA_PROVEEDOR=gemini
# Clave de API de Gemini (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Modelo del proveedor elegido (con Ollama, por ejemplo llama3.2:3b). Conviene verificar en AI Studio que el nombre de Gemini siga vigente.
AIDA_MODELO=gemini-3.5-flash-lite
# Opcional: otro modelo de Gemini que se prueba si el principal sigue saturado (error 503) después de los reintentos.
# AIDA_MODELO_RESPALDO=
